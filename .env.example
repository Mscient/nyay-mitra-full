# ── Nyay Mitra — Environment Variables Template ──────────────────────────────
# Copy this file to .env and fill in your values. Never commit .env directly.

# ── Sarvam AI (Chat & Document Generation) ───────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here

# ── Auth (identity-svc) ───────────────────────────────────────────────────────
# MUST be changed in production — use a 64-char random string
JWT_SECRET=change-this-to-a-secure-random-64-char-secret

# ── Service Ports (local dev) ─────────────────────────────────────────────────
PORT=4001                         # identity-svc port
WORKSPACE_PORT=4002               # workspace-svc port

# ── Service URLs (set these in Railway environment variables) ─────────────────
# In Railway, each service gets its own URL — set these per-service
IDENTITY_SVC_URL=https://identity-svc.railway.app
WORKSPACE_SVC_URL=https://workspace-svc.railway.app

# ── Database (PostgreSQL — required for production persistence) ───────────────
# In Railway: add a PostgreSQL plugin and Railway auto-sets DATABASE_URL
DATABASE_URL=postgresql://user:password@host:5432/nyaymitra

# ── Next.js web app ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.railway.app

# ── Google OAuth (register/login) ────────────────────────────────────────────
# Register at https://console.cloud.google.com → APIs → OAuth 2.0
# Add your Railway domain as an Authorized JavaScript Origin
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
