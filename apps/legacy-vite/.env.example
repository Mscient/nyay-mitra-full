# Nyay Mitra — Environment Variables

# ─────────────────────────────────────────────
# REQUIRED — App will not start without these
# ─────────────────────────────────────────────

# Sarvam AI API key — powers all Indian-language AI features
# Get yours at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_key_here

# JWT secret for session tokens — use a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_in_production

# ─────────────────────────────────────────────
# OPTIONAL — Enhances features when provided
# ─────────────────────────────────────────────

# IndianKanoon API token — enables live real court case search
# Free for non-commercial use. Get at: https://api.indiankanoon.org
INDIANKANOON_API_TOKEN=

# eCourts API (ECIAPI) — live case status from district/high courts
# Register at: https://eciapi.akshit.me
ECIAPI_TOKEN=

# WhatsApp Business API (Meta) — for voice note processing via WhatsApp
# Register at: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_TOKEN=

# Google OAuth (for social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────
# SERVER CONFIG
# ─────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# Database path (SQLite — relative to project root)
DATABASE_URL=./nyay_mitra.db
